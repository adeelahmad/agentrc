# syntax=agentrc.agentfile/v0.1

# A locked-down agent: minimal capability, no sub-agents, a single
# allowed egress host, and tightly scoped tools. Everything below is a
# REQUEST. The platform reads the ai.agentrc.* labels (not this file) and
# grants, narrows, or rejects each request, then enforces via Cedar.

# --- Base / inheritance -----------------------------------------------------
FROM ghcr.io/acme/hardened-base:1.2

# --- Identity ---------------------------------------------------------------
IDENTITY name=secure-workspace version=1.0 author=acme
IDENTITY description="Read/write files in a scoped workspace under strict, deny-by-default policy"

# --- Capabilities -----------------------------------------------------------
CAPABILITY text

# --- System prompt / objective ----------------------------------------------
SOP <<EOF
You are a workspace assistant operating under strict policy.
Only read and write files in your assigned workspace.
Never attempt to exfiltrate data or reach hosts you were not granted.
If a task needs more than you are permitted, stop and report it.
EOF

# --- Invocation surface -----------------------------------------------------
CMD python -m secure_workspace.main

# --- Tools (local, embedded) ------------------------------------------------
COPY --chmod=755 ./tools/file_read  /mnt/tools/file_read
COPY --chmod=755 ./tools/file_write /mnt/tools/file_write

# --- Secrets: DEFERRED — no secret declared here; credential resolution, if
#     any is needed, is platform-defined (see the spec's "Secrets (deferred)"). -

# --- Policy: substrate-side requests ----------------------------------------
POLICY substrate.runtime.memory 2gb
POLICY substrate.runtime.cpu    2

# --- Policy: agent-side requests --------------------------------------------
POLICY agent.tool_timeout 30s
POLICY agent.sub_agents   false

# --- Policy: network egress requests ----------------------------------------
POLICY network dns:api.github.com:443

# --- Liveness ---------------------------------------------------------------
HEALTHCHECK --interval=60s --timeout=10s --retries=3 CMD /mnt/tools/file_read --agentrc-schema

# Enforcement note: this file carries no policy language. The PLATFORM
# enforces deny-by-default, and any org-level Cedar `forbid` (for example,
# "no agent may write under /etc") lives platform-side and is un-loosenable
# by this agent. Authors speak only typed POLICY requests; Cedar is never an
# Agentfile author surface.

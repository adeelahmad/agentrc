# syntax=agentrc.agentfile/v0.1

AGENT secure-workspace
CMD strands run --agent secure-workspace

# Runner capability requirements. These are not the runtime; they are requested profiles.
PLUGIN network
PLUGIN filesystem

MOUNT /workspace rw
BIND ./repo /workspace copy

TOOL utci:file_read
TOOL utci:file_write
TOOL utci:current_time

URL https://api.github.com
AUDIT all
RATELIMIT file_write 5/min
HEALTHCHECK --interval=60s --timeout=10s CMD utci:ping

POLICY
  permit(
    principal == AgentRC::Agent::"secure-workspace",
    action in [AgentRC::Action::"tool.invoke"],
    resource in [AgentRC::Tool::"file_read", AgentRC::Tool::"file_write", AgentRC::Tool::"current_time"]
  );

  forbid(
    principal,
    action == AgentRC::Action::"filesystem.write",
    resource
  )
  when { context.path.startsWith("/etc") };
END

# syntax=agentrc.io/agentfile:v1

# vault-agent — secret-broker focus.
# This Agentfile only NAMES a secret and its host scope; the value never
# enters the artifact or the running agent. The secret SOURCE (e.g. HashiCorp
# Vault) is platform-side: the platform's broker resolves the named secret and
# injects it at the network layer, only for the allowed host.

IDENTITY name=vault-agent version=1.0 author=acme
IDENTITY description="Reads from an internal database using a platform-injected credential"

CAPABILITY text

SOP You are a database read assistant. Query only what the user asks for; never echo credentials or connection strings.

CMD python -m vault_agent.main

# Local tool, embedded as a layer.
COPY --chmod=755 ./tools/db_query /mnt/tools/db_query

# Secret as a reference, never a value. The label NAMES the secret and scopes
# it to one host; the platform's secret broker (e.g. Vault) resolves the value
# at run time and injects it for db.internal.example only. No CRED keyword, no
# secret material in the Agentfile, the layers, or the labels.
LABEL org.agentrc.secret.db_password=host:db.internal.example

# Egress request: reach the database host on its port. The platform grants,
# narrows, or rejects this; deny-by-default means no other egress is honoured.
POLICY network dns:db.internal.example:5432

(* agentrc Agentfile grammar, v0.1.0-draft.4. *)

agentfile       = { line } ;
line            = ws , ( comment | directive | policy-end | empty ) , newline ;
empty           = "" ;
comment         = "#" , { any-char } ;
inline-comment  = ws , "#" , { any-char } ;

directive       = simple-directive [ inline-comment ]
                | sop-reference [ inline-comment ]
                | policy-block
                | sop-block ;

simple-directive = keyword , { ws , argument } ;
keyword          = "AGENT" | "FROM" | "SHELL" | "CMD" | "TOOL" | "TOOLSET"
                 | "FUNCTION" | "SKILL" | "SERVER" | "MCP" | "URL" | "CRED"
                 | "BIND" | "MOUNT" | "PLUGIN" | "ALLOW" | "DENY" | "RATELIMIT"
                 | "AUDIT" | "TIMEOUT" | "LIMIT" | "SLICE" | "IMAGE" | "ISOLATION"
                 | "BROKER" | "BACKEND" | "TRACE" | "MEMORY" | "OPTIMIZER"
                 | "HEALTHCHECK" ;

policy-block    = "POLICY" , [ ws , policy-profile ] , newline ,
                  { policy-line , newline } ,
                  "END" ;
policy-profile  = identifier ;
policy-line     = { any-char - line-containing-only-END } ;

(*
  SOP has two forms, disambiguated by the argument:
    - single-line reference: the argument is a file path or registry/OCI
      reference (contains "/", "://", or a file extension) and no block follows;
    - inline block: the argument is a bare name and the directive opens a
      verbatim block closed by a line containing only END (like POLICY).
*)
sop-reference   = "SOP" , ws , reference ;
reference       = bare-token ;
sop-block       = "SOP" , ws , identifier , newline ,
                  { sop-line , newline } ,
                  "END" ;
sop-line        = { any-char - line-containing-only-END } ;

argument        = bare-token ;
bare-token      = { visible-char - ws } ;
identifier      = letter , { letter | digit | "-" | "_" | "." | ":" } ;
ws              = { " " | "\t" } ;
newline         = "\n" | "\r\n" ;

(*
  v0.1 uses whitespace-separated arguments for compatibility with the current
  implementation. Future versions may add quoted strings and line continuations.
*)

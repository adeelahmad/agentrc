---
layout: none
permalink: /site.webmanifest
sitemap: false
---
{
  "name": "{{ site.title }} — {{ site.tagline }}",
  "short_name": "{{ site.title }}",
  "description": "{{ site.description }}",
  "icons": [
    { "src": "{{ '/assets/brand/icon-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/brand/icon-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png" }
  ],
  "theme_color": "#060912",
  "background_color": "#060912",
  "display": "standalone",
  "start_url": "{{ '/' | relative_url }}"
}
